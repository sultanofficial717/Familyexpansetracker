rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyAdmin(familyId) {
      return isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.adminUid == request.auth.uid;
    }

    function isMemberOfFamily(familyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // User lookup mapping (required for registering new users)
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Family Rules
    match /families/{familyId} {
      allow get: if isSignedIn();
      allow list: if false;
      // Allow user to create a family with themselves as admin
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isFamilyAdmin(familyId) && request.resource.data.adminUid == request.auth.uid;
      allow delete: if false;

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isMemberOfFamily(familyId) || isFamilyAdmin(familyId);
        allow create: if isFamilyAdmin(familyId);
        allow update: if isFamilyAdmin(familyId);
        allow delete: if isFamilyAdmin(familyId);
      }

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isMemberOfFamily(familyId) || isFamilyAdmin(familyId);
        allow create: if isSignedIn() && (isMemberOfFamily(familyId) || isFamilyAdmin(familyId)) 
                       && request.resource.data.memberId == request.auth.uid;
        allow update: if isFamilyAdmin(familyId) || (isSignedIn() && resource.data.memberId == request.auth.uid);
        allow delete: if isFamilyAdmin(familyId) || (isSignedIn() && resource.data.memberId == request.auth.uid);
      }

      // Budgets Subcollection
      match /budgets/{month} {
        allow read: if isMemberOfFamily(familyId) || isFamilyAdmin(familyId);
        allow write: if isFamilyAdmin(familyId);
      }
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
